{
  "name": "@ryantzhou/dsh-codex",
  "version": "0.2.0",
  "description": "Codex-style tools and agent preset for DeepSeek Harness",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanzhou/dsh-codex.git"
  },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22.19.0" },
  "files": ["dist", "agent-presets", "cordis.patch.yml", "LICENSE", "NOTICE", "README.md", "THIRD_PARTY_LICENSES"],
  "exports": {
    ".": { "types": "./dist/tools.d.ts", "import": "./dist/tools.js" },
    "./host": { "types": "./dist/host.d.ts", "import": "./dist/host.js" }
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "check": "tsc -p tsconfig.json --noEmit && oxlint src test",
    "test": "vitest run",
    "prepack": "npm run build && npm run check && npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent-presets": "0.1.0-rc.6",
    "@deepseek-ai/dsh-jobs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.6",
    "@deepseek-ai/dsh-shell-env": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-agent-presets": { "optional": true },
    "@deepseek-ai/dsh-jobs": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-llm-pi-ai": { "optional": true },
    "@deepseek-ai/dsh-sandbox": { "optional": true },
    "@deepseek-ai/dsh-sandbox-policy": { "optional": true },
    "@deepseek-ai/dsh-shell": { "optional": true },
    "@deepseek-ai/dsh-shell-env": { "optional": true },
    "@deepseek-ai/dsh-subprocess": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent-presets": "0.1.0-rc.6",
    "@deepseek-ai/dsh-jobs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.6",
    "@deepseek-ai/dsh-shell-env": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@earendil-works/pi-ai": "0.82.1",
    "@types/node": "^24.10.0",
    "oxlint": "^1.36.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
